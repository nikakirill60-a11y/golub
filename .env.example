# Copy to .env and restrict permissions (chmod 600 .env on Linux).
# Portable literal KEY=value syntax; quote spaces/# with single or double quotes.
# No shell expansion, command substitution, multiline values or executable code.
# Explicit process variables override this file in Tools/unity.py.

# Public runtime settings: only these three values may be embedded in players.
# Empty values disable the corresponding integration and clear stale resources.
BLITZ_SENTRY_DSN=''
BLITZ_DIRECT_SERVER=''
BLITZ_PHOTON_APP_ID=''

# Secrets/build-machine settings: NEVER embedded in runtime resources.
# Use the original release key to update an already installed APK.
BLITZ_ANDROID_KEYSTORE=''
BLITZ_ANDROID_KEYSTORE_PASSWORD=''
BLITZ_ANDROID_KEY_ALIAS=''
BLITZ_ANDROID_KEY_PASSWORD=''
SENTRY_ORG=''
SENTRY_PROJECT=''
# Empty: use the token saved by sentry-cli login (~/.sentryclirc).
SENTRY_AUTH_TOKEN=''

# Optional dedicated-server operations (not required to build a player).
BLITZ_DIRECT_DEPLOY_TARGET=''
SSH_KEY=''
DIRECT_HOST=''
DIRECT_SSH_USER=''
DIRECT_SSH_KEY=''
# DIRECT_PORT='7777'

# Optional Windows VM automation (not required for native Windows builds).
# BLITZ_WINDOWS_IL2CPP_COMMAND='/absolute/path/to/project/Tools/windows_il2cpp_runner.sh'
# BLITZ_WINDOWS_BUILDER_DIR='/absolute/path/to/blitz-windows-builder'
# BLITZ_WINDOWS_CONTAINER='blitz-windows-builder'
# BLITZ_WINDOWS_SSH_USER='blitz'
# SSH transport: 'forward' (QEMU loopback forward, default) or 'container'
# (docker exec/nc to the guest address on bridge networking).
# BLITZ_WINDOWS_SSH_MODE='forward'
# BLITZ_WINDOWS_SSH_HOST='127.0.0.1'
# BLITZ_WINDOWS_SSH_PORT='2222'
# BLITZ_WINDOWS_SSH_HOST_KEY_ALIAS='blitz-windows-builder'
# UNITY='C:/Program Files/Unity/Hub/Editor/7000.0.0a8/Editor/Unity.exe'
# UNITY_HUB_EDITORS='/absolute/path/to/Unity/Hub/Editor'
# BLITZ_DOTNET='/absolute/path/to/dotnet'
