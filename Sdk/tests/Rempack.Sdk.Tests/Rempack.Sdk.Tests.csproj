<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Rempack.Sdk.Tests</AssemblyName>
    <RootNamespace>BlitzLegacy.Sdk.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The game's package tests are written for Unity's NUnit and run here unchanged. -->
    <NoWarn>$(NoWarn);NUnit2005;NUnit2006;NUnit2007;NUnit2015;NUnit2045;NUnit1032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rempack.Cli/Rempack.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets a test compare the CLI's embedded texts with the game's file. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameRoot</_Parameter1>
      <_Parameter2>$(GameRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- The same package tests the game runs, against the same sources the CLI compiles. -->
    <Compile Include="$(GameTests)/Rempack*Tests.cs" Link="Game/%(Filename)%(Extension)" />
    <Compile Include="$(GameTests)/RempackFixture.cs" Link="Game/RempackFixture.cs" />
    <Compile Include="$(GameTests)/ModState*Tests.cs" Link="Game/%(Filename)%(Extension)" />
    <Compile Include="$(GameTests)/ModCrashGuard*Tests.cs" Link="Game/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
